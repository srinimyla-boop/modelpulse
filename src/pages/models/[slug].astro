---
import Layout from '../../components/Layout.astro';
import Tags from '../../components/Tags.astro';
import Announcement from '../../components/Announcement.astro';
import { loadCatalog, dateLabel, contextLabel } from '../../lib/catalog';
import { label } from '../../lib/taxonomy';

export async function getStaticPaths() {
  const { models } = await loadCatalog();
  return models.map((model) => ({ params: { slug: model.id }, props: { model } }));
}

const { model } = Astro.props;
---
<Layout title={model.name} description={model.summary}>
  <div class="page-intro">
    <a class="back-link" href="/">← Model explorer</a>
    <p class="eyebrow"><a href={`/developers/${model.developer.id}/`}>{model.developer.name}</a> · {model.family}</p>
    <h1>{model.name}<span class="accent">.</span></h1>
    <p class="lede">{model.summary}</p>
    <div class="page-actions"><a class="action" href={`/compare/?models=${model.id}`}>Compare with another model</a><Announcement url={model.announcementUrl} /></div>
  </div>
  <section aria-labelledby="spec-title">
    <h2 id="spec-title">Specifications</h2>
    <dl class="specs">
      <div><dt>Developer</dt><dd><a href={`/developers/${model.developer.id}/`}>{model.developer.name}</a></dd></div>
      <div><dt>Family</dt><dd>{model.family}</dd></div>
      <div><dt>Release date</dt><dd><time datetime={model.releaseDate}>{dateLabel(model.releaseDate)}</time></dd></div>
      <div><dt>Status</dt><dd>{label(model.status)}</dd></div>
      <div><dt>Capabilities</dt><dd><Tags values={model.capabilities} /></dd></div>
      <div><dt>Context window</dt><dd>{contextLabel(model.contextWindowTokens)}</dd></div>
      <div><dt>Availability</dt><dd><Tags values={model.availability} /></dd></div>
      <div><dt>License</dt><dd>{model.license}</dd></div>
    </dl>
  </section>
</Layout>
